@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title</title>

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css">

    <style>
        body {
            font-family: 'Poppins', sans-serif;
            background: linear-gradient(to right, #f8f9fa, #e9ecef);
        }

        .top-nav {
            background: brown;
            color: white;
            padding: 8px 0;
            font-size: 14px;
            text-align: center;
        }

        .navbar {
            background: white;
            padding: 25px;
            box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
            text-size-adjust: 50%;
        }

        .navbar-brand {
            font-size: 26px;
            font-weight: bold;
            color: brown;
        }

        .navbar-nav .nav-link {
            font-weight: 600;
            color: firebrick;
            transition: 0.3s;
            padding: 10px 15px;
            font-size: larger;
        }

            .navbar-nav .nav-link:hover {
                color: forestgreen;
            }


        .navbar h2 {
            color: darkred;
            font-weight: bold;
            text-align: right;
            margin-bottom: 0; 
        }

        .dropdown-menu {
            display: none;
            opacity: 0;
            transform: translateY(15px);
            transition: all 0.3s ease-in-out;
        }

        .nav-item:hover .dropdown-menu {
            display: block;
            opacity: 1;
            transform: translateY(0);
        }


        .footer {
            background: firebrick;
            color: white;
            text-align: center;
            padding: 8px 0;
            font-size: 16px;
            bottom: 0;
            width: 100%;
            position: fixed;
        }

        .btn-custom {
            background: #E96C20;
            color: white;
            font-weight: bold;
            padding: 10px 20px;
            transition: 0.3s;
            border-radius: 5px;
        }

            .btn-custom:hover {
                background: #c45418;
                color: white;
            }
    </style>
</head>
<body>


    <!-- Main Navigation -->
    <nav class="navbar navbar-expand-lg ">
        <div class="container-fluid d-flex align-items-center justify-content-between">

            <a class="navbar-brand p-0 me-auto mx-lg-5" href="#">
                <img src="~/Uploads/ICFAI.jpg"
                     alt="ICFAI Logo"
                     style="height: 70px; width: 200px; ">
            </a>

            <h2 class="my-0 text-center mx-lg-5">NodelOfficer DashBoard </h2>

            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse justify-content-end" id="navbarNav">
                <ul class="navbar-nav">
                    <li class="nav-item"><a class="nav-link" href="@Url.Action("Dashboard", "NodelOfficer")">Home</a></li>
                    @*<li class="nav-item"><a class="nav-link" href="@Url.Action("RaiseRequest", "Employee")">Raise Request</a></li>
                        <li class="nav-item"><a class="nav-link" href="@Url.Action("MyRequests", "Employee")">My Request</a></li>*@


                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle" href="#" id="icfaiLifeMenu" role="button">My Profile</a>
                        <ul class="dropdown-menu">
                            <li><a class="dropdown-item nav-link" id="myProfileLink" href="@Url.Action("MyProfile", "Login")">Profile Details</a></li>
                            <li><a class="dropdown-item" href="@Url.Action("Logout", "Login")">Logout</a></li>
                        </ul>

                        <div class="modal fade" id="myProfileModal" tabindex="-1" aria-hidden="true">
                            <div class="modal-dialog">
                                <div class="modal-content" id="myProfileContent">
                                </div>
                            </div>
                        </div>
                    </li>
                </ul>
            </div>
        </div>
    </nav>
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

    <div class="container">
        @RenderBody()
    </div>


    <footer class="footer">
        <p style="margin-top: 0; margin-bottom: 0rem;">
            © 2025 ICFAI Foundation for Higher Education. All Rights Reserved.
        </p>
    </footer>

    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

    <script>

        $(document).ready(function () {
            function hideSubmenu() {
                $('.dropdown-menu').removeClass('show'); 
                $('.dropdown-toggle').attr('aria-expanded', 'false'); 
            }

            $('#addTypesSubmenu').click(function (e) {
                e.preventDefault();
                $(this).next('.dropdown-menu').toggleClass('d-none'); 
            });

            $('#addTypesSubmenu1').click(function (e) {
                e.preventDefault();
                $(this).next('.dropdown-menu').toggleClass('d-none'); 
            });
            $('#addTypesSubmenu2').click(function (e) {
                e.preventDefault();
                $(this).next('.dropdown-menu').toggleClass('d-none'); 
            });

            $(document).click(function (e) {
                if (!$(e.target).closest('.dropend').length) {
                    hideSubmenu();
                }
            });

            $('#addTypesSubmenu .dropdown-menu .dropdown-item').click(function () {
                location.reload(); 
            });
            $('#addTypesSubmenu1 .dropdown-menu .dropdown-item').click(function () {
                location.reload(); 
            });
            $('#addTypesSubmenu2 .dropdown-menu .dropdown-item').click(function () {
                location.reload(); 
            });

            $("#myProfileLink").click(function (e) {
                e.preventDefault();

                $.get("/Login/MyProfile", function (data) {
                    $("#myProfileContent").html(data);

                    $("#myProfileModal").modal("show");
                });
            });
            (function () {
                window.history.pushState(null, "", window.location.href);
                window.onpopstate = function () {
                    window.history.pushState(null, "", window.location.href);
                };
            })();

        });</script>

    @RenderSection("Scripts", required: false)

</body>
</html>