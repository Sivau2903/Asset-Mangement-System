@model IEnumerable<WebApplication5.Models.BDSAsset>

@{
    ViewBag.Title = "Issue QR Codes";
    Layout = "~/Views/Shared/_NodelLayout.cshtml";
}

<div class="container mt-4">
    <h3 class="mb-4">Issue QR Codes for Assets</h3>

    <ul class="nav nav-tabs" id="qrTabs">
        <li class="nav-item">
            <a class="nav-link active" data-bs-toggle="tab" href="#notIssued">QR Not Issued</a>
        </li>
        <li class="nav-item">
            <a class="nav-link" data-bs-toggle="tab" href="#issued">QR Issued</a>
        </li>
    </ul>

    <div class="tab-content mt-3">

        <!-- NOT ISSUED -->
        <div class="tab-pane fade show active" id="notIssued">
            <div style="max-height: 400px; overflow-y: auto; border: 1px solid #dee2e6; border-radius: 5px;">
                <table class="table table-striped table-bordered align-middle text-left mb-0">
                    <thead class="table-dark sticky-top">
                        <tr>
                            <th>Sub Category</th>
                            <th>User Name</th>
                            <th>Designation</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var asset in Model.Where(a => a.IsQRIssued == false))
                        {
                            <tr>
                                <td>@asset.MaterialSubCategory</td>
                                <td>@asset.UserName</td>
                                <td>@asset.Designation</td>
                                <td>
                                    <button class="btn btn-warning btn-sm issue-qr-btn"
                                            data-id="@asset.AssetID"
                                            disabled>
                                        Issue
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <!-- ISSUED -->
        <div class="tab-pane fade" id="issued">
            <div style="max-height: 400px; overflow-y: auto; border: 1px solid #dee2e6; border-radius: 5px;">
                <table class="table table-striped table-bordered align-middle text-left mb-0">
                    <thead class="table-dark sticky-top">
                        <tr>
                            <th>Sub Category</th>
                            <th>User Name</th>
                            <th>Designation</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var asset in Model.Where(a => a.IsQRIssued == true))
                        {
                            <tr>
                                <td>@asset.MaterialSubCategory</td>
                                <td>@asset.UserName</td>
                                <td>@asset.Designation</td>
                                <td>
                                    <span class="badge bg-success px-3 py-2">Issued</span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- QR Modal -->
<div class="modal fade" id="qrModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content p-3">
            <div class="modal-header">
                <h5 class="modal-title">QR Code Sticker</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body text-center" id="qrModalContent">
                <p>Loading...</p>
            </div>
            <div class="modal-footer justify-content-center">
                <button class="btn btn-primary" onclick="printQRSticker()">Print Sticker</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
    $(document).ready(function () {
        // Enable button only if data exists
        $("tr").each(function () {
            const user = $(this).find("td:nth-child(2)").text().trim();
            const desg = $(this).find("td:nth-child(3)").text().trim();
            if (user && desg) {
                $(this).find(".issue-qr-btn").prop("disabled", false);
            }
        });

        // Handle QR issue
        $(".issue-qr-btn").click(function () {
            const assetId = $(this).data("id");
            const btn = $(this);
            btn.prop("disabled", true).text("Processing...");

            $.post("@Url.Action("IssueQRCode", "NodelOfficer")", { assetId: assetId }, function (response) {
                if (response.success) {
                    $("#qrModalContent").load(response.redirectUrl, function () {
                        $("#qrModal").modal("show");
                    });
                    btn.closest("tr").fadeOut();
                } else {
                    alert("Failed to generate QR code.");
                    btn.prop("disabled", false).text("Issue");
                }
            });
        });
    });

    function printQRSticker() {
        const printContents = document.getElementById("printableQR").outerHTML;
        const printWindow = window.open("", "", "width=400,height=400");
        printWindow.document.write(`
            <html>
                <head>
                    <title>Print QR Sticker</title>
                    <style>
                        page { size: 2in 2in; margin: 0; }
                        body { width:2in; height:2in; margin:0; display:flex; align-items:center; justify-content:center; }
                    </style>
                </head>
                <body>${printContents}</body>
            </html>
        `);
        printWindow.document.close();
        printWindow.print();
    }
    </script>
}
